  {
    "id": "e5e0000000000020",
    "type": "function",
    "z": "e5e0000000000001",
    "name": "preparar interfaz",
    "func": "const CAMPO = \"distancia\";\nconst ESTADOS = [\"BARRIDO\", \"ASENTAMIENTO\", \"DISPARAR\", \"ESP_HIGH\", \"ESP_LOW\", \"ACT_PANTALLA\", \"ERROR_SEGURO\"];\n\nconst p = msg.payload;\nlet medidor = null, serie = null, estado = null;\nif (typeof p[CAMPO] === \"number\") {\n    medidor = { payload: p[CAMPO] };\n    serie = { topic: CAMPO, payload: p[CAMPO] };\n}\nif (typeof p.estado === \"number\") {\n    estado = { payload: (ESTADOS[p.estado] || (\"estado \" + p.estado)) + (p.sensor_ok === 0 ? \" · sensor con falla\" : \"\") };\n}\nreturn [medidor, serie, estado];",
    "outputs": 3,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 540,
    "y": 140,
    "wires": [
      [
        "e5e0000000000021"
      ],
