    {
        "id": "n_fn_cmd",
        "type": "function",
        "z": "tab_p14_radar",
        "name": "armar comando",
        "func": "const accion = msg.payload;\nif (accion !== \"ON\" && accion !== \"OFF\") {\n    return null;\n}\nmsg.payload = { cmd: accion };\nreturn msg;",
